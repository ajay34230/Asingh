## Registers all translations and applies the saved language.
static func setup() -> void:
	for i in range(1, LANGUAGES.size()):
		var tr := Translation.new()
		tr.locale = LANGUAGES[i][0]
		for key in T:
			tr.add_message(key, T[key][i - 1])
		TranslationServer.add_translation(tr)
	apply(String(GameSettings.get_option("language")))


static func apply(code: String) -> void:
	TranslationServer.set_locale(code if code != "" else "en")

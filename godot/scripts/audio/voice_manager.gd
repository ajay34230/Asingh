## Spoken Hindi dialogue (generated by tools/make_voice.py): an announcer and a voice per
## token colour. Lines never overlap, repeat lines are spaced out, and the music dips
## while someone speaks. Returns the caption so the HUD can subtitle it.
class_name VoiceManager
extends Node

const LINES_PATH := "res://assets/audio/voice/lines.json"
const ANNOUNCER_GAP := 2.2      ## seconds between announcer lines

var enabled := true
var audio: AudioManager         ## for mute, volume and music ducking
var _table: Dictionary = {}
var _streams: Dictionary = {}
var _announcer: AudioStreamPlayer
var _tokens: AudioStreamPlayer
var _last_announce := -100.0
var _last_pick: Dictionary = {}  ## key -> last variant index, to avoid instant repeats


func _ready() -> void:
	var file := FileAccess.open(LINES_PATH, FileAccess.READ)
	if file:
		var parsed: Variant = JSON.parse_string(file.get_as_text())
		if parsed is Dictionary:
			_table = parsed
	_announcer = AudioStreamPlayer.new()
	_announcer.bus = "SFX"
	add_child(_announcer)
	_tokens = AudioStreamPlayer.new()
	_tokens.bus = "SFX"
	add_child(_tokens)
	_announcer.finished.connect(_unduck)
	_tokens.finished.connect(_unduck)


## Plays an announcer line for `key` and returns its caption ("" if nothing played).
func announce(key: String, force := false) -> String:
	if not _can_speak():
		return ""
	var now := Time.get_ticks_msec() / 1000.0
	if not force and now - _last_announce < ANNOUNCER_GAP:
		return ""
	var lines: Array = _table.get("announcer", {}).get(key, [])
	if lines.is_empty():
		return ""
	var line: Dictionary = _pick(key, lines)
	_last_announce = now
	_play(_announcer, line["file"])
	return line["caption"]


## A token speaks (taunt, hurt, cheer) in its colour's voice. Returns the caption.
func token_line(key: String, color: String) -> String:
	if not _can_speak():
		return ""
	var by_color: Dictionary = _table.get("token", {}).get(key, {})
	var lines: Array = by_color.get(color, [])
	if lines.is_empty():
		return ""
	var line: Dictionary = _pick(key + color, lines)
	_play(_tokens, line["file"])
	return line["caption"]


func _can_speak() -> bool:
	return enabled and not (audio and audio.muted)


func _pick(key: String, lines: Array) -> Dictionary:
	var index := randi() % lines.size()
	if lines.size() > 1 and _last_pick.get(key, -1) == index:
		index = (index + 1) % lines.size()
	_last_pick[key] = index
	return lines[index]


func _play(player: AudioStreamPlayer, file: String) -> void:
	if not _streams.has(file):
		_streams[file] = load("res://assets/audio/voice/%s.ogg" % file)
	player.stream = _streams[file]
	player.volume_db = (audio.sfx_volume_db if audio else 0.0) + 2.0
	player.play()
	if audio:
		audio.duck_music(true)


func _unduck() -> void:
	if audio and not _announcer.playing and not _tokens.playing:
		audio.duck_music(false)
